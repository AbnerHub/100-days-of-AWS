# --- Windows System Files ---
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# --- VS Code / WSL Specific ---
.vscode/
*.code-workspace
.history/
.vscode-server/
.devcontainer/

# --- Terraform / Infrastructure as Code ---
# Local .terraform directories
**/.terraform/*

# .tfstate files (Contains sensitive data/secrets)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (Likely contains sensitive credentials)
*.tfvars
*.tfvars.json

# --- Docker & Containers ---
.docker/
*.tar
*.tar.gz

# --- OS / Linux (WSL) ---
.DS_Store
.directory
*.swp
*~
.fuse_hidden*
.nfs*

# --- Environment & Credentials ---
# Never commit these to GitHub
.env
.env.local
.env.*.local
.aws/
.credentials/
*.pem
*.key
*.pub

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
